#!/bin/bash

### 安装完成后：建立数据目录并确保权限可写。

PKGVAR="${TRIM_PKGVAR:-/tmp/fn-scx4623}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - install: $1" >> "${LOG_FILE}"
}

mkdir -p "${PKGVAR}/scans" || {
    echo "无法创建扫描数据目录 ${PKGVAR}/scans" >> "${LOG_FILE}"
    exit 1
}
mkdir -p "${PKGVAR}/tmp"

# 若向导提供了打印机名，落盘一份便于排查
if [ -n "${WIZARD_PRINTER}" ]; then
    printf "%s" "${WIZARD_PRINTER}" > "${PKGVAR}/printer.name"
fi

log_msg "directories ready: ${PKGVAR}/scans"
exit 0
