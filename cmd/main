#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 应用文件根：fnpack 可能把 app/ 内容平铺到 target/，也可能保留 app/ 层。
# 参照系统自带应用的写法，两种布局都探测，避免路径写死导致起不来。
APPDEST=""
for _base in "${TRIM_APPDEST:-}" "$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"; do
    [ -z "${_base}" ] && continue
    for _sub in "app/server/server.py" "server/server.py"; do
        if [ -f "${_base}/${_sub}" ]; then
            APPDEST="$_base"
            break 2
        fi
    done
done
[ -z "${APPDEST}" ] && APPDEST="${TRIM_APPDEST:-$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)}"

PKGVAR="${TRIM_PKGVAR:-/tmp/fn-scx4623}"
PORT="${TRIM_SERVICE_PORT:-8372}"

# 定位服务脚本（平铺布局在 server/，保留 app/ 层时在 app/server/）
SERVER_SCRIPT=""
for _sub in "app/server/server.py" "server/server.py"; do
    if [ -f "${APPDEST}/${_sub}" ]; then
        SERVER_SCRIPT="${APPDEST}/${_sub}"
        break
    fi
done
[ -z "${SERVER_SCRIPT}" ] && SERVER_SCRIPT="${APPDEST}/app/server/server.py"

# 启动内置 HTTP 服务（打印 / 复印 / 扫描 / 预览）
CMD="exec python3 '${SERVER_SCRIPT}' --port ${PORT}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        return 0
    fi

    mkdir -p "${PKGVAR}/scans" 2>/dev/null
    log_msg "Starting fn-scx4623 on port ${PORT} ..."

    bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"

    # 先给 1 秒：路径写错 / 依赖缺失会在这之内暴露
    sleep 1
    if ! status; then
        log_msg "service failed to start: $(tail -n 3 "${LOG_FILE}" | tr '\n' ' ')"
        rm -f "${PID_FILE}"
        return 1
    fi

    # 再等端口真正监听（最多 10 秒），中途死掉也算失败
    local i=0
    while [ $i -lt 10 ]; do
        if ss -tln 2>/dev/null | grep -q ":${PORT} "; then
            log_msg "service ready on port ${PORT} (pid=$(cat "${PID_FILE}"))"
            return 0
        fi
        if ! status; then
            log_msg "service exited during startup"
            rm -f "${PID_FILE}"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done

    log_msg "service running but port ${PORT} not listening"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"

        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove stale pid file"
            return 0
        fi

        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}" 2>/dev/null
            sleep 1
        fi
        rm -f "${PID_FILE}"
    fi

    return 0
}

check_process() {
    local pid=$1
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
